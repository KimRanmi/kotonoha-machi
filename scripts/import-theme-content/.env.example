# cp .env.example .env 로 복사해서 실제 키를 넣는다. .env는 .gitignore에 등록돼 있다.
GEMINI_API_KEY=
# 구글 시트 "kotonoha-machi 테마 콘텐츠"의 각 탭을 CSV로 웹에 게시한 URL (npm run import용)
THEME_SHEET_THEMES_CSV_URL=
THEME_SHEET_KANJI_CSV_URL=
THEME_SHEET_VOCABULARY_CSV_URL=
THEME_SHEET_EXAMPLES_CSV_URL=
# propose --to-sheet용: 시트에 붙인 Apps Script 웹 앱 주소와 비밀 토큰(apps-script/Code.gs 참고)
THEME_SHEET_WEBHOOK_URL=
THEME_SHEET_WEBHOOK_TOKEN=
