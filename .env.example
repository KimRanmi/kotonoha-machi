# docker-compose.yml(로컬 PostgreSQL)과 백엔드가 함께 쓰는 DB 설정. `cp .env.example .env` 로 복사해 쓰세요.
# 아래는 로컬 개발 전용 값입니다. 운영 환경의 실제 비밀번호는 절대 여기에 넣어 커밋하지 마세요.
DB_NAME=kotonoha
DB_USER=kotonoha
DB_PASSWORD=kotonoha
DB_PORT=5432
# 백엔드가 접속할 JDBC URL (포트를 바꿨다면 함께 수정)
DB_URL=jdbc:postgresql://localhost:5432/kotonoha
