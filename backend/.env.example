# backend/.env를 만들 때 이 파일을 복사해서 쓴다 (cp .env.example .env).
# 여기 적힌 값은 전부 예시/기본값이고, 실제 키 값은 .env에만 넣는다
# (.env는 .gitignore에 등록돼 있어서 git에 올라가지 않는다).

# --- 데이터베이스 (루트 docker-compose.yml 기본값과 맞춰져 있음) ---
# Docker로 백엔드를 띄울 때는 compose가 DB_HOST/DB_PORT를 db 서비스로 덮어쓴다.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kotonoha_machi
DB_USERNAME=kotonoha_machi
DB_PASSWORD=kotonoha_machi

# --- 서버/세션 ---
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
# 로컬 HTTP 환경에서 세션 쿠키를 직접 테스트할 때만 false로 바꾼다.
SESSION_COOKIE_SECURE=true

# --- 이메일 발송 (Resend, docs/decisions/0005-email-sending.md 참고) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# --- 소셜 로그인 (발급 방법은 노션 "소셜 로그인 구현 정리" 문서 참고) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 음성 합성 (Google Cloud Text-to-Speech) ---
# 키를 비워 두면 음성 합성 API가 503을 돌려주고, 프런트엔드는 브라우저 기본 음성으로 대신한다.
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=ja-JP-Neural2-C
