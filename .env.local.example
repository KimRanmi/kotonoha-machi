# Google Gemini API 키. https://aistudio.google.com/apikey 에서 발급받아 채워 넣으세요.
GEMINI_API_KEY=

# (선택) 주민 응답 생성에 사용할 모델. 비워두면 기본값(gemini-3.5-flash)을 사용합니다.
# GEMINI_MODEL=gemini-3.5-flash

# JWT 서명 키(32바이트 이상). 비워두면 서버 시작 때마다 임의 키를 쓰므로 재시작하면 access 토큰이 무효가 됩니다(refresh 쿠키로 복구됨).
# 생성 예: openssl rand -base64 48   (실제 값은 .env.local에만 넣고 커밋하지 마세요)
# JWT_SECRET=
# HTTPS로 서비스할 때만 true (refresh 쿠키가 HTTPS 연결에서만 전송됨). 로컬 http 개발에서는 비워 두세요.
# AUTH_COOKIE_SECURE=false
