# Google Gemini API 키. https://aistudio.google.com/apikey 에서 발급받아 채워 넣으세요.
GEMINI_API_KEY=

# (선택) 주민 응답 생성에 사용할 모델. 비워두면 기본값(gemini-3.5-flash)을 사용합니다.
# GEMINI_MODEL=gemini-3.5-flash

# JWT 서명 키(32바이트 이상). 비워두면 서버 시작 때마다 임의 키를 쓰므로 재시작하면 로그인이 풀립니다.
# 생성 예: openssl rand -base64 48   (실제 값은 .env.local에만 넣고 커밋하지 마세요)
# JWT_SECRET=
