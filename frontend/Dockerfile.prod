# 운영용 이미지: 1단계에서 정적 파일(dist)을 만들고, 2단계 Caddy가 그 파일을 서빙하면서
# /api 등 백엔드 경로는 리버스 프록시한다(설정은 Caddyfile). 개발용 Dockerfile은 건드리지 않는다.
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json .npmrc ./
RUN npm ci

COPY . .
# 빈 값 = 상대 경로로 호출한다. 같은 도메인에서 /api를 백엔드로 넘기므로 주소를 박을 필요가 없다.
# (client.ts의 `?? 'http://localhost:8080'`는 빈 문자열을 기본값으로 바꾸지 않는다.)
ENV VITE_API_BASE_URL=""
RUN npm run build

FROM caddy:2-alpine
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
